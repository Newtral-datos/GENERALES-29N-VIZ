{
	"name": "elecciones-panel",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"homepage": "https://newtral-datos.github.io/GENERALES-29N-VIZ/",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d build --nojekyll",
		"prepare": "svelte-kit sync || echo ''",
